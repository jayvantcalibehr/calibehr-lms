APP_NAME="Calibehr LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=calibehr_lms_new
DB_USERNAME=root
DB_PASSWORD=

MITRA_OLD_DB_HOST=127.0.0.1
MITRA_OLD_DB_PORT=3306
MITRA_OLD_DB_DATABASE=calibehr_mitra
MITRA_OLD_DB_USERNAME=root
MITRA_OLD_DB_PASSWORD=

LMS_OLD_DB_HOST=127.0.0.1
LMS_OLD_DB_PORT=3306
LMS_OLD_DB_DATABASE=calibehr_lms
LMS_OLD_DB_USERNAME=root
LMS_OLD_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=technology-lms-data
AWS_USE_PATH_STYLE_ENDPOINT=false
